FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global tsx@4

COPY . .

RUN python3 -m venv /opt/shift-solver-venv \
    && /opt/shift-solver-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/shift-solver-venv/bin/pip install --no-cache-dir -r solver_cli/requirements.txt pyinstaller

ENV PATH="/opt/shift-solver-venv/bin:${PATH}"

RUN tsx desktop/solver/nodeBuildSolver.ts --platform=linux-x64 --force --skip-readiness \
    && test -x desktop/packaging/resources/solver/linux-x64/shift-solver

ENV PORT=3000
ENV WEB_HOST=0.0.0.0
ENV SOLVER_TIME_LIMIT_SECONDS=30

EXPOSE 3000

CMD ["tsx", "desktop/web/publicGateway.ts"]
