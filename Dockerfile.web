FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global tsx@4

COPY . .

RUN chmod +x desktop/packaging/resources/solver/linux-x64/* 2>/dev/null || true

ENV PORT=3000
ENV WEB_HOST=0.0.0.0
ENV SOLVER_TIME_LIMIT_SECONDS=30

EXPOSE 3000

CMD ["tsx", "desktop/web/publicGateway.ts"]
